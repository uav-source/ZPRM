{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fmb1-reporting-correction-notice-v1",
  "title": "FMB1 versioned solver-status reporting correction notice v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "CORRECTION_TYPE",
    "CORRECTION_SCOPE",
    "POSTHOC_DIAGNOSTIC_TRIGGERED",
    "SCIENTIFIC_ANALYSIS_RERUN",
    "REGISTRATION_RERUN",
    "RAW_POSE_RECOMPUTATION",
    "PRIMARY_ESTIMAND_RECOMPUTATION",
    "P_VALUE_RECOMPUTATION",
    "REASSOCIATION_RECOMPUTATION",
    "SYSTEMATIC_COMPONENT_RECOMPUTATION",
    "ORIGINAL_REPORTED_SOLVER_NONCONVERGED_FINITE_N",
    "CORRECTED_FORMAL_COMPLETED_N",
    "CORRECTED_FORMAL_SOLVER_NONCONVERGENCE_N",
    "ROOT_CAUSE",
    "corrected_accounting",
    "paper_wording"
  ],
  "properties": {
    "schema": {"const": "fmb1_solver_status_reporting_correction_notice_v1"},
    "status": {"const": "AUTHORITATIVE_VERSIONED_REPORTING_CORRECTION"},
    "CORRECTION_TYPE": {"const": "VERSIONED_REPORTING_CORRECTION"},
    "CORRECTION_SCOPE": {"const": "SOLVER_STATUS_ACCOUNTING_ONLY"},
    "POSTHOC_DIAGNOSTIC_TRIGGERED": {"const": true},
    "SCIENTIFIC_ANALYSIS_RERUN": {"const": false},
    "REGISTRATION_RERUN": {"const": false},
    "RAW_POSE_RECOMPUTATION": {"const": false},
    "PRIMARY_ESTIMAND_RECOMPUTATION": {"const": false},
    "P_VALUE_RECOMPUTATION": {"const": false},
    "REASSOCIATION_RECOMPUTATION": {"const": false},
    "SYSTEMATIC_COMPONENT_RECOMPUTATION": {"const": false},
    "ORIGINAL_REPORTED_SOLVER_NONCONVERGED_FINITE_N": {"const": 360},
    "CORRECTED_FORMAL_COMPLETED_N": {"const": 360},
    "CORRECTED_FORMAL_SOLVER_NONCONVERGENCE_N": {"const": 0},
    "ROOT_CAUSE": {"const": "WRONG_SOLVER_STATUS_STRING_MAPPING"},
    "corrected_accounting": {"type": "object"},
    "paper_wording": {"type": "object"}
  }
}
