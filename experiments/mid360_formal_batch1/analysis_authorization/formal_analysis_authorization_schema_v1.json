{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fmb1_formal_analysis_authorization_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "authorization_id", "authorization_type", "authorization_basis",
    "issued_at_utc", "published_at_utc", "nonce", "lifecycle_state",
    "analysis_lock_revision", "analysis_lock_fingerprint",
    "analysis_lock_file_sha256", "analysis_lock_sha256",
    "analysis_lock_release_commit", "analysis_control_commit",
    "locked_analysis_code_commit", "analysis_code_commit",
    "raw_execution_commit", "postrun_verification_commit",
    "c2_clarification_commit", "r3_lock_fingerprint",
    "formal_results_root", "postrun_verification_root", "analysis_output_root",
    "analysis_output_schema_sha256", "track_id", "authorization_scope",
    "allow_read_frozen_formal_results", "allow_scientific_aggregation",
    "allow_primary_exact_permutation", "allow_secondary_rotation",
    "allow_cross_backend_analysis", "allow_reassociation_analysis",
    "allow_systematic_component_analysis", "allow_registration",
    "allow_capture_radius", "allow_modify_formal_results",
    "allow_modify_analysis_code", "allow_change_statistics", "reusable",
    "immutable", "REAL_SCIENTIFIC_ANALYSIS_AUTHORIZED", "consumed",
    "verification_report_sha256", "fixture_only"
  ],
  "properties": {
    "schema": {"const": "fmb1_formal_analysis_authorization_v1"},
    "authorization_id": {"type": "string", "pattern": "^[A-Z0-9_-]{20,160}$"},
    "authorization_type": {"const": "ONE_TIME_FMB1_LOCKED_SCIENTIFIC_ANALYSIS"},
    "authorization_basis": {"const": "EXPLICIT_USER_INSTRUCTION_RECORDED_BY_OPERATOR"},
    "issued_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
    "published_at_utc": {"type": ["string", "null"]},
    "nonce": {"type": "string", "pattern": "^[a-f0-9]{32,64}$"},
    "lifecycle_state": {"enum": ["ISSUED", "VERIFIED_PUBLISHED"]},
    "analysis_lock_revision": {"const": 2},
    "analysis_lock_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_lock_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_lock_release_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "analysis_control_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "locked_analysis_code_commit": {"const": "215a7961ed93dac9cf691e1e8ccd99d7ee868175"},
    "analysis_code_commit": {"const": "215a7961ed93dac9cf691e1e8ccd99d7ee868175"},
    "raw_execution_commit": {"const": "059e39533991d929a97ab208ad738643af82d09a"},
    "postrun_verification_commit": {"const": "18bb94e62761f5193da8cdc5509c470cb4983244"},
    "c2_clarification_commit": {"const": "364c0ae76801c373d9ea6a4d9dd36e2fdf211e09"},
    "r3_lock_fingerprint": {"const": "fd601e8daf62c488a3a079beea05f65c9bd283399ae4d7f3acf16e63fc473a6d"},
    "formal_results_root": {"type": "string", "minLength": 1},
    "postrun_verification_root": {"type": "string", "minLength": 1},
    "analysis_output_root": {"type": "string", "minLength": 1},
    "analysis_output_schema_sha256": {"const": "707e2d5f7030c090a30ebb5cfb74f07373e04a223ac1beae94e53bc502eec23e"},
    "track_id": {"const": "ZERO_PERTURBATION_TRACK"},
    "authorization_scope": {"const": "ONE_AUTHORITATIVE_LOCKED_SCIENTIFIC_ANALYSIS_RUN"},
    "allow_read_frozen_formal_results": {"const": true},
    "allow_scientific_aggregation": {"const": true},
    "allow_primary_exact_permutation": {"const": true},
    "allow_secondary_rotation": {"const": true},
    "allow_cross_backend_analysis": {"const": true},
    "allow_reassociation_analysis": {"const": true},
    "allow_systematic_component_analysis": {"const": true},
    "allow_registration": {"const": false},
    "allow_capture_radius": {"const": false},
    "allow_modify_formal_results": {"const": false},
    "allow_modify_analysis_code": {"const": false},
    "allow_change_statistics": {"const": false},
    "reusable": {"const": false},
    "immutable": {"const": true},
    "REAL_SCIENTIFIC_ANALYSIS_AUTHORIZED": {"const": true},
    "consumed": {"const": false},
    "verification_report_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "fixture_only": {"type": "boolean"}
  }
}
