{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zprm:fmb1:formal-registration-authorization:exec-r3:v1",
  "title": "FMB1 Zero-Perturbation one-time formal registration authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorization_id",
    "authorization_type",
    "authorization_basis",
    "issued_at_utc",
    "nonce",
    "status",
    "track_id",
    "active_amendment_id",
    "lock_revision",
    "lock_fingerprint",
    "lock_file_sha256",
    "lock_release_commit",
    "binding_inventory_sha256",
    "binding_provenance_contract",
    "trial_plan_sha256",
    "analysis_contract_sha256",
    "backend_contract_sha256",
    "execution_code_commit",
    "environment_manifest_sha256",
    "pcl_binary_sha256",
    "planned_trial_count",
    "planned_open3d_count",
    "planned_pcl_count",
    "allowed_backends",
    "T0_policy",
    "execution_mode_initial",
    "resume_allowed",
    "workers",
    "capture_radius_authorized",
    "other_backend_authorized",
    "parameter_change_authorized",
    "trial_reselection_authorized",
    "authorization_scope",
    "authoritative_runtime_root",
    "immutable",
    "FORMAL_ICP_UNLOCKED",
    "FORMAL_REGISTRATION_AUTHORIZED"
  ],
  "properties": {
    "schema": {"const": "mid360_fmb1_formal_registration_authorization_exec_r3_v1"},
    "authorization_id": {"type": "string", "pattern": "^FMB1-AUTH-[0-9a-f]{32}$"},
    "authorization_type": {"const": "ONE_TIME_FMB1_ZERO_PERTURBATION_FORMAL_EXECUTION"},
    "authorization_basis": {"const": "EXPLICIT_USER_INSTRUCTION_RECORDED_BY_OPERATOR"},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "ISSUED"},
    "track_id": {"const": "ZERO_PERTURBATION_TRACK"},
    "active_amendment_id": {"const": "FMB1_ZERO_PERTURBATION_MAINLINE_V1_1_R1"},
    "lock_revision": {"const": 3},
    "lock_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lock_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lock_release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binding_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_provenance_contract": {"const": "EXPLICIT_PER_BINDING_V1"},
    "trial_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pcl_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planned_trial_count": {"const": 360},
    "planned_open3d_count": {"const": 180},
    "planned_pcl_count": {"const": 180},
    "allowed_backends": {
      "type": "array",
      "prefixItems": [
        {"const": "OPEN3D_POINT_TO_PLANE"},
        {"const": "PCL_POINT_TO_PLANE"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "T0_policy": {"const": "IDENTITY_ONLY"},
    "execution_mode_initial": {"const": "fresh"},
    "resume_allowed": {"const": true},
    "workers": {"const": 2},
    "capture_radius_authorized": {"const": false},
    "other_backend_authorized": {"const": false},
    "parameter_change_authorized": {"const": false},
    "trial_reselection_authorized": {"const": false},
    "authorization_scope": {"const": "ONE_FORMAL_EXECUTION_ATTEMPT_WITH_RESUME_ONLY"},
    "authoritative_runtime_root": {"const": "zero_perturbation_runtime/mid360_zero_perturbation_v1_1_formal_execution_v1"},
    "immutable": {"const": true},
    "FORMAL_ICP_UNLOCKED": {"const": true},
    "FORMAL_REGISTRATION_AUTHORIZED": {"const": true}
  }
}
